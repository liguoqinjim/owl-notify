# owl-notify Configuration File
# Place this file at ~/.owl-notify.toml or ./.owl-notify.toml

# ============================================================================
# Naming Convention
# ============================================================================
# - Platform and channel are separated by dot (.)
# - Platform names use underscores (_) for word separation
# - Channel names use hyphens (-) for word separation
# - Example: weixin_markdown_v2.nbl-alerts

# ============================================================================
# Global Defaults (Optional)
# ============================================================================
[defaults]
timeout = 30        # Request timeout in seconds (default: 30)

# ============================================================================
# Error Handling and Retry Configuration
# ============================================================================
[error]
max_retries = 3                                    # Maximum number of retry attempts (default: 3)
retry_delay_ms = 1000                              # Delay between retries in milliseconds (default: 1000ms = 1s)
notification_platform = "weixin_markdown_v2.nbl-alerts"  # Platform to send error notifications
                                                   # Examples: "weixin_markdown_v2.nbl-alerts", "bark.phone-1"
                                                   # Leave empty to disable error notifications

# How it works:
# 1. When a notification fails, it will retry up to max_retries times
# 2. Between each retry, it waits retry_delay_ms milliseconds
# 3. If all retries fail, an error notification is sent to notification_platform
# 4. Error notifications themselves do not retry (to prevent infinite loops)

# ============================================================================
# Base Platform Configurations
# ============================================================================

# Bark Configuration
# Get your device token from the Bark app
[bark]
server_url = "https://api.day.app"
token = "your-bark-token-here"
# Optional: Sound and other settings
# sound = "bell"
# badge = 1
# group = "MyGroup"

# Weixin Work Bot (Text Format)
[weixin]
bot_url = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here"

# Weixin Work Bot (Markdown Format)
[weixin_markdown_v2]
bot_url = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-markdown-key-here"

# ============================================================================
# Platform Channels (Inheritance)
# ============================================================================
# Channels inherit configuration from their base platform.
# Format: [platform.channel-name]

# Bark channels - inherit from [bark]
[bark.phone-1]
token = "phone1-token"
# Inherits: server_url from [bark]

[bark.phone-2]
token = "phone2-token"
# Inherits: server_url from [bark]

[bark.work-device]
token = "work-device-token"
timeout = 60  # Override timeout for this channel

# Weixin channels - inherit from [weixin]
# Method 1: Use 'key' field (auto-generates bot_url)
[weixin.team-alerts]
key = "team-alerts-key"
# Auto-generated: bot_url = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=team-alerts-key"

[weixin.prod-monitor]
key = "prod-monitor-key"

# Method 2: Use full bot_url (overrides base configuration)
[weixin.custom-endpoint]
bot_url = "https://custom-weixin-server.com/webhook?key=custom-key"

# Weixin Markdown V2 channels - inherit from [weixin_markdown_v2]
[weixin_markdown_v2.nbl-alerts]
key = "nbl-alerts-key"
# Auto-generated bot_url with the key

[weixin_markdown_v2.prod-delist]
key = "prod-delist-key"

# ============================================================================
# Webhook Channels (Independent, No Inheritance)
# ============================================================================
# Webhook channels are independent and do not support inheritance.
# Each webhook.xxx channel must have its own complete configuration.
# Format: [webhook.channel-name]

# Slack webhook
[webhook.slack-team1]
url = "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX"
method = "POST"
body = '{"text": "{{title}}\\n{{message}}"}'

# Discord webhook
[webhook.discord-alerts]
url = "https://discord.com/api/webhooks/123456789/xxxxxxxxxxxxx"
method = "POST"
body = '{"content": "**{{title}}**\\n{{message}}"}'

# Custom GET webhook with URL template
[webhook.custom-get]
url = "https://api.example.com/notify?title={{title}}&message={{message}}"
method = "GET"

# n8n webhook
[webhook.n8n-notify]
url = "https://n8n.example.com/webhook/xxxxx?title={{title}}&content={{message}}"
method = "GET"

# ============================================================================
# Custom Platforms (For Reusable Webhook Configurations)
# ============================================================================
# If you need to reuse webhook configurations, create a custom platform.
# Custom platforms support inheritance like built-in platforms.

# Example: Slack platform with multiple channels
[slack]
method = "POST"
body = '{"text": "{{title}}\\n{{message}}"}'

[slack.team1]
url = "https://hooks.slack.com/services/T11111111/B11111111/YYYYYYYYYYYYYYYYYYYY"
# Inherits: method and body from [slack]

[slack.team2]
url = "https://hooks.slack.com/services/T22222222/B22222222/ZZZZZZZZZZZZZZZZZZZZ"
# Inherits: method and body from [slack]

# ============================================================================
# Usage Examples
# ============================================================================

# CLI:
#   owl "Title" "Message" --platform bark
#   owl "Title" "Message" --platform bark.phone-1
#   owl "Title" "Message" --platform weixin.team-alerts
#   owl "Title" "Message" --platform weixin_markdown_v2.nbl-alerts
#   owl "Title" "Message" --platform webhook.slack-team1
#   owl "Title" "Message" --platform slack.team1

# Python:
#   import owl_notify
#
#   # Using platform constants (recommended)
#   owl_notify.send("Title", "Message", platform=owl_notify.platform.bark)
#   owl_notify.send("Title", "Message", platform=owl_notify.platform.bark.channel("phone-1"))
#   owl_notify.send("Title", "Message", platform=owl_notify.platform.weixin.channel("team-alerts"))
#   owl_notify.send("Title", "Message", platform=owl_notify.platform.webhook.channel("slack-team1"))
#
#   # Using strings (also supported)
#   owl_notify.send("Title", "Message", platform="bark")
#   owl_notify.send("Title", "Message", platform="bark.phone-1")
#   owl_notify.send("Title", "Message", platform="weixin.team-alerts")
#   owl_notify.send("Title", "Message", platform="webhook.slack-team1")
